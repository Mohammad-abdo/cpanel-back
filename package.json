{
  "name": "nodeteam-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:webmail": "node --watch --env-file-if-exists=.env src/webmail-server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:webmail": "node --env-file-if-exists=.env src/webmail-server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "drill:security": "node scripts/drill-security.mjs",
    "dev:ssh": "node scripts/dev-ssh-server.mjs",
    "test:security": "node scripts/security-tests.mjs",
    "drill:recovery": "node --env-file-if-exists=.env scripts/recovery-drill.mjs",
    "test:load": "node scripts/load-test.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^2.12.1",
    "mailparser": "3.7.1",
    "nodemailer": "^10.6.0",
    "socket.io": "4.8.1",
    "ssh2": "^1.17.0",
    "ws": "^8.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "supertest": "^7.3.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
