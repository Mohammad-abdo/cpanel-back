{
  "name": "@nodeteam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node --env-file-if-exists=.env prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nodeteam/event-schemas": "0.1.0",
    "@nodeteam/permission-catalog": "0.1.0",
    "@nodeteam/shared-contracts": "0.1.0",
    "@prisma/client": "^6.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
