NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Laragon local MySQL — never commit real credentials.
DATABASE_URL=mysql://root:@127.0.0.1:3306/nodeteam_control
# REDIS_URL is optional; only needed for apps/worker. API/Web run without it.
# REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-long-random-dev-secret

# Local development only. Generate a different key for any real environment and keep it out of git.
BACKUP_ENCRYPTION_KEY=30428b434b029fa1c874f00fc0c62a680fdedf25e92a0519c168df244d63df07
