NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Laragon local MySQL (required for auth/data routes). No Docker required.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/nodeteam_control
# Optional — only if you start apps/worker. API does not require Redis.
# REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-long-random-dev-secret

# Encrypts saved server SSH passwords. 32 bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and backed up: losing it makes every saved SSH login unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Backup encryption key (same format).
BACKUP_ENCRYPTION_KEY=

# TASK-053 project provisioning (Apache + certbot + PM2). Default simulated: no server contact.
PROVISION_EXECUTOR=simulated
# PROJECT_PROVISIONING_DISABLED=1
# PROVISION_APP_ROOT=/var/www
# PROVISION_PORT_START=21000
# PROVISION_PORT_END=21999
