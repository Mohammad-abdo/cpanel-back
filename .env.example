NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Laragon local MySQL (required for auth/data routes). No Docker required.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/nodeteam_control
# Optional — only if you start apps/worker. API does not require Redis.
# REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-long-random-dev-secret
